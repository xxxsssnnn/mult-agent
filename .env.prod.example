# 生产环境变量示例 —— 复制为 .env.prod 并填入真实强口令/随机密钥。
# 切勿把 .env.prod 提交到版本库（已在 .gitignore 中忽略）。
#
#   cp .env.prod.example .env.prod
#   docker compose -f compose.prod.yml --env-file .env.prod up -d --build

# --- 数据库（必须使用强口令，禁止默认值）---
POSTGRES_DB=multi_agent
POSTGRES_USER=app
POSTGRES_PASSWORD=请替换为强随机口令

# --- Redis（必须设置口令）---
REDIS_PASSWORD=请替换为强随机口令

# --- JWT 密钥（必须 >=32 位随机字符串，禁止默认值）---
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=请替换为至少32位的随机字符串
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM（按需）---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
DEFAULT_TEMPERATURE=0.7

# --- CORS（生产仅允许真实前端域名）---
BACKEND_CORS_ORIGINS=["https://your-domain.example.com"]

# --- 其它 ---
BCRYPT_ROUNDS=12
