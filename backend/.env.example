# Core Settings
APP_NAME="Multi-Agent Platform"
APP_VERSION="1.0.0"
# 运行环境: development / production（production 会启用启动期安全校验，见 app/core/config.py）
ENVIRONMENT=development
# 安全默认：DEBUG 默认关闭；本地调试可显式设为 True
DEBUG=False
API_V1_PREFIX="/api/v1"

# Database
# 默认不含固定口令；生产环境必须提供强口令，否则启动期校验会拒绝
DATABASE_URL="postgresql+asyncpg://postgres@localhost:5432/multi_agent"
DATABASE_ECHO=False

# Redis
REDIS_URL="redis://localhost:6379/0"

# JWT
# 生产环境必须替换为 >=32 位随机字符串（否则启动失败）
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"
DEFAULT_TEMPERATURE=0.7

# Celery
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Security
BCRYPT_ROUNDS=12

# Vector Database
CHROMA_HOST="localhost"
CHROMA_PORT=8000
